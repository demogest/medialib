{
  "rclone": "rclone",
  "ffmpeg": "ffmpeg",
  "ffprobe": "ffprobe",
  "port": 8766,
  "default_player": "my-mpv",
  "players": [
    {
      "id": "my-mpv",
      "name": "mpv (portable)",
      "path": "D:\\Apps\\mpv\\mpv.exe",
      "title_arg": "--force-media-title={title}"
    }
  ],
  "active": "videos",
  "connections": [
    {
      "id": "rustfs",
      "name": "RustFS",
      "provider": "rustfs",
      "endpoint": "https://s3.example.com",
      "region": "us-east-1",
      "access_key": "YOUR_ACCESS_KEY",
      "secret_key_env": "RUSTFS_SECRET_KEY",
      "addressing": "path",
      "verify_tls": true,
      "default_bucket": ""
    }
  ],
  "libraries": [
    {
      "id": "videos",
      "name": "Videos",
      "type": "local",
      "path": "%USERPROFILE%\\Videos"
    },
    {
      "id": "nas",
      "name": "NAS",
      "type": "local",
      "path": "\\\\nas\\media\\videos"
    },
    {
      "id": "s3-videos",
      "name": "S3 videos",
      "type": "s3",
      "connection": "rustfs",
      "bucket": "media",
      "prefix": "videos/"
    }
  ]
}
